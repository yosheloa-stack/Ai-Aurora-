# Copie este arquivo para .env e preencha com suas chaves reais.
# O .env nunca deve ser commitado (já está no .gitignore).

# Obrigatória para o servidor de chat (src/api/server.ts).
# Gere em https://console.anthropic.com
ANTHROPIC_API_KEY=

# Usada pela ferramenta "buscar_na_web" e pela CLI de busca (npm run search).
# Gere em https://brave.com/search/api/
BRAVE_API_KEY=

# Usada pelas ferramentas de clima/wikipedia/youtube/filme/anime/manga/pinterest
# e pela CLI (npm run tools).
TOKITO_API_KEY=

# Porta do servidor de chat (opcional, padrão 3000).
PORT=3000

# Modelo da Claude usado pelo servidor de chat (opcional, padrão claude-opus-5).
CLAUDE_MODEL=claude-opus-5
